# ============================================================
# ZD-AI 飞书智能助手 · 环境变量配置
# ============================================================
# 使用方法：复制此文件为 .env，填入真实值
# 规则：.env 已加入 .gitignore，绝不提交到 GitHub
# ============================================================

# ---- 飞书机器人 ----------------------------------------------------
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=
FEISHU_ENCRYPT_KEY=
FEISHU_VERIFICATION_TOKEN=
FEISHU_BOT_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ---- Dify（RAG 推理） ---------------------------------------------
# DIFY_BASE_URL：内网压测环境（生产建议用 https://api.dify.ai/v1）
DIFY_BASE_URL=http://43.139.56.65:6789/v1
# DIFY_APP_API_KEY：Dify 应用级别 Key（调用 /chat-messages）
DIFY_APP_API_KEY=
# DIFY_DATASET_API_KEY：Dify 数据集管理 Key（上传文档到知识库）
DIFY_DATASET_API_KEY=
# DIFY_DATASET_ID：知识库数据集 ID（上传文件时使用）
DIFY_DATASET_ID=fd9ec943-0448-4011-8c1f-a2910da3699d
# DIFY_KNOWLEDGE_DATASET_ID：用于 RAG 检索的数据集 ID
DIFY_KNOWLEDGE_DATASET_ID=qxcL9snI73CH1ul1jw8J7CqUoI15qWEWVHbqLRaBoilr5M5vXEq7kPyQ/xc6pA8z

# ---- Supabase（订单数据查询） ------------------------------------
# 格式：https://<project_ref>.supabase.co
SUPABASE_URL=https://fejyztnqjdytxeuhvwhv.supabase.co
# 匿名密钥（前端只读权限，行级安全保护）
SUPABASE_ANON_KEY=

# ---- 腾讯云 COS（图片持久化） ------------------------------------
# COS 凭证：在腾讯云控制台创建子用户 + 授权策略后生成
TENCENT_COS_CREDENTIALS_ID=tencent-cos-credentials
TENCENT_COS_BUCKET=mybucket23-1380052631
TENCENT_COS_REGION=ap-guangzhou
# CDN 基础地址（可选，用于图片访问加速）
CDN_BASE_URL=

# ---- hohoAPI（多模态图片解析） -----------------------------------
# 通过 hohoAPI 转发 GPT-4o/Qwen-VL 等多模态模型
HOHO_API_CREDENTIAL_ID=hoho-api-credentials
IMAGE_ANALYSIS_URL=https://www.hohoapi.com/v1/chat/completions
IMAGE_ANALYSIS_MODEL=gpt-5.5-2026-04-24

# ---- Redis（幂等键存储，生产推荐） --------------------------------
# n8n 重启后 global 内存会丢失幂等状态
# 生产环境建议：REDIS_URL=redis://<host>:<port>/0
REDIS_URL=redis://localhost:6379

# ---- n8n ----------------------------------------------------------
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_URL=https://your-domain.com/webhook/feishu-upload
N8N_API_KEY=

# ---- 邮件（商务线索通知） ----------------------------------------
SALES_EMAIL_TO=sales@your-company.com
SMTP_FROM=noreply@your-company.com
SMTP_HOST=smtp.example.com

# ---- 日志 & 可观测 -----------------------------------------------
LOG_LEVEL=info
