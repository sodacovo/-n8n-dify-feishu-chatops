      "parameters": {
        "jsCode": "// Code-去重\nconst eventId = $('Webhook-飞书入口').item.json.body.header.event_id;\n\nif (!global.processedEventIds) {\n  global.processedEventIds = new Set();\n}\n\nconst cache = global.processedEventIds;\n\n// 已存在 → 重复\nif (cache.has(eventId)) {\n  return [{ json: { duplicate: true, event_id: eventId } }];\n}\n\n// 不存在 → 加进去\ncache.add(eventId);\n\nreturn [{ json: { duplicate: false, event_id: eventId } }];"
