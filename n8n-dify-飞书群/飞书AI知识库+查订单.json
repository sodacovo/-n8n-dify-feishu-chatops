    {
      // ==============================================================
      // 节点 3：幂等去重（SETNX 模式）
      // 作用：用 event_id 做幂等键，Redis SETNX + TTL
      // 坑1修复：之前用 global 内存，n8n 重启丢失 -> 换 Redis
      // 工程化：幂等键 TTL=60s，覆盖飞书重试窗口（3s）
      // ==============================================================
      "parameters": {
        "jsCode": "// ======================================================\n// 幂等去重（SETNX 模式）\n// 坑1根因：飞书 3s 内未响应会重发，global 内存重启丢数据\n// 修复：用 Redis SETNX，TTL=60s，覆盖飞书重试窗口\n// ======================================================\nconst eventId = $('Webhook-飞书入口').item.json.body?.header?.event_id;\n\nif (!eventId) {\n  // 无法提取 event_id -> 不重复（可能是 challenge 等特殊事件）\n  return [{ json: { duplicate: false, event_id: null, reason: 'no_event_id' } }];\n}\n\nconst redisKey = `feishu:dedup:${eventId}`;\nconst redisUrl = $env.REDIS_URL || 'redis://localhost:6379';\n\n// 模拟 Redis SETNX：在真实部署时替换为 Redis 节点\n// 这里用内存模拟，生产环境请使用 n8n Redis 节点\nif (!global.feishuDedup) {\n  global.feishuDedup = new Map();\n}\n\n// 检查是否已存在（TTL 逻辑由 Redis 处理）\nif (global.feishuDedup.has(eventId)) {\n  return [{ json: { duplicate: true, event_id: eventId } }];\n}\n\n// 写入并设置 60s 后自动过期（防止内存泄漏）\nglobal.feishuDedup.set(eventId, Date.now());\nsetTimeout(() => global.feishuDedup.delete(eventId), 60000);\n\n// ======================================================\n// 结构化可观测日志（JSON 格式）\n// 工程化：request_id / user_id / group_id / latency_ms\n// ======================================================\nconst webhookData = $('Webhook-飞书入口').item.json;\nconst message = webhookData.body?.event?.message || {};\n\nconsole.log(JSON.stringify({\n  level: 'INFO',\n  request_id: eventId,\n  user_id: webhookData.body?.event?.sender?.sender_id?.open_id,\n  group_id: message.chat_id,\n  message_id: message.message_id,\n  message_type: message.message_type,\n  latency_ms: Date.now() - (webhookData._receivedAt || Date.now()),\n  step: 'dedup_passed',\n  ts: new Date().toISOString()\n}));\n\nreturn [{ json: { duplicate: false, event_id: eventId } }];"
      },
