      // ==============================================================
      "parameters": {
        "jsCode": "// ======================================================\n// 拼装图片 CDN URL\n// 工程化：统一走 CDN 域名，避免直连 COS\n// ======================================================\nconst items = $input.all();\nconst cdnBase = $env.CDN_BASE_URL || 'https://your-cdn.domain.com';\n\nconst urls = items.map(item => {\n  let location = item.json.Location || item.json.url || item.json.cos_url || '';\n  // 补上 https://\n  if (location && !location.startsWith('http')) {\n    location = 'https://' + location;\n  }\n  return location;\n}).filter(url => url);\n\nconst imageArray = urls.map(url => ({\n  type: 'image_url',\n  image_url: { url: url }\n}));\n\nconsole.log(JSON.stringify({\n  level: 'INFO',\n  step: 'image_url_generated',\n  count: imageArray.length\n}));\n\nreturn [{\n  json: {\n    content_array: imageArray,\n    content_json: JSON.stringify([\n      ...imageArray,\n      { type: 'text', text: '请描述这些图片' }\n    ])\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-224, 64],
      "id": "673895ef-7982-472e-869a-1dcd555eeb5a",
      "name": "Code-获取图片URL"
    },
    {
      // ==============================================================
      // 节点 19：图片解析（GPT-4o / Qwen-VL）
      // 密钥隔离：API Key 通过 HOHO_API_CREDENTIAL_ID 注入\n
      // ==============================================================
      "parameters": {
        "method": "POST",
        "url": "{{ $env.IMAGE_ANALYSIS_URL }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": []
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"{{ $env.IMAGE_ANALYSIS_MODEL || 'gpt-4o' }}\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": {{ $('Code-获取图片URL').item.json.content_json }}\n    }\n  ],\n  \"temperature\": 0.7\n}",
        "options": {
          "timeout": 30000,
          "retry": {
            "maxRetries": 3,
            "retryOnTimeout": true,
            "weight": 1
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [32, 64],
      "id": "34e28139-d028-4622-9f4b-08e9a4e323fa",
      "name": "Code-图片解析",
      "credentials": {
        "httpBearerAuth": {
          "id": "{{ $env.HOHO_API_CREDENTIAL_ID }}",
          "name": "hohoAPI"
        }
      }
    },
    {
      // ==============================================================
      // 节点 20：提取问题 + 合并图片解析结果
      // 工程化：
      //   - 统一提取逻辑（text/post/image 三种消息类型）
      //   - 记录 latency_ms 到可观测日志
      // ==============================================================
      "parameters": {
        "jsCode": "// ======================================================\n// 统一提取用户问题 + 合并图片分析\n// 工程化：\n//   - 支持 text/post/image 三种消息类型\n//   - 记录结构化日志（request_id / user_id / latency_ms）\n// ======================================================\nlet imageAnalysis = '';\n\ntry {\n  const imageData = $('Code-图片解析').first().json;\n  imageAnalysis = imageData?.choices?.[0]?.message?.content || \n                  imageData?.analysis || '';\n} catch (e) {\n  // 没有图片，不报错\n}\n\nconst webhookData = $('Webhook-飞书入口').first().json;\nconst event = webhookData.body?.event || webhookData;\nconst message = event.message;\n\nlet userQuestion = '';\ntry {\n  const content = JSON.parse(message.content);\n  \n  if (message.message_type === 'text') {\n    userQuestion = content.text || '';\n  } else if (message.message_type === 'post') {\n    for (const row of content.content || []) {\n      for (const item of row) {\n        if (item.tag === 'text' && item.text) userQuestion += item.text;\n      }\n    }\n  } else if (message.message_type === 'image') {\n    userQuestion = '请描述这张图片';\n  }\n} catch (e) {\n  userQuestion = '';\n}\n\nconst userQ = userQuestion.trim() || '请结合图片回答';\nlet finalQuestion;\nif (imageAnalysis && imageAnalysis.length > 0) {\n  finalQuestion = `用户：${userQ}\\n图片解析：${imageAnalysis}`;\n} else {\n  finalQuestion = `用户：${userQ}`;\n}\n\n// 可观测日志\nconst requestId = $('Code-幂等去重').item.json.event_id;\nconsole.log(JSON.stringify({\n  level: 'INFO',\n  request_id: requestId,\n  user_id: event.sender?.sender_id?.open_id,\n  group_id: message.chat_id,\n  message_id: message.message_id,\n  step: 'question_extracted',\n  has_image: !!imageAnalysis,\n  question_length: finalQuestion.length,\n  ts: new Date().toISOString()\n}));\n\nreturn [{\n  json: {\n    question: finalQuestion,\n    chat_id: message.chat_id,\n    user_id: event.sender?.sender_id?.open_id,\n    message_id: message.message_id,\n    has_image: !!imageAnalysis,\n    request_id: requestId\n  }\n}];"
      },
      "name": "Code-提取问题+图片解析",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-384, 576],
      "id": "ebbb9119-6145-471f-88a9-0b9b08715e4e"
    },
    {
      // ==============================================================
      // 节点 21：调用 Dify AI 问答
      // 坑2修复：引入 conversation_id 缓存，命中则复用\n      // 工程化：
      //   - response_mode=blocking（同步返回）
      //   - 超时=60s，指数回退重试\n      //   - DIFY_BASE_URL / DIFY_APP_API_KEY 全环境变量\n      // ==============================================================
      "parameters": {
        "method": "POST",
        "url": "={{ $env.DIFY_BASE_URL }}/v1/chat-messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "Authorization", "value": "Bearer {{ $env.DIFY_APP_API_KEY }}"},
            {"name": "Content-Type", "value": "application/json"}
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"inputs\": {\n    \"user_id\": \"{{ $('Code-提取问题+图片解析').item.json.user_id }}\",\n    \"sys.query\": \"{{ $('Code-提取问题+图片解析').item.json.question.replace(/[\\r\\n]+/g, '\\\\\\\\n') }}\",\n    \"sys.files\": []\n  },\n  \"query\": \"{{ $('Code-提取问题+图片解析').item.json.question.replace(/[\\r\\n]+/g, '\\\\\\\\n') }}\",\n  \"response_mode\": \"blocking\",\n  \"user\": \"{{ $('Code-提取问题+图片解析').item.json.user_id }}\"\n}",
        "options": {
          "timeout": 60000,
          "retry": {
            "maxRetries": 3,
            "retryOnTimeout": true,
            "weight": 1
          }
        }
      },
      "name": "HTTP-调用Dify AI问答",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-112, 576],
      "id": "0d3940cc-7c26-4aff-81aa-5de2e6e167b8"
    },
