      // ==============================================================
      // 节点 14：提取图片/文件信息
      // 作用：统一处理 post/image/file 三种类型的附件提取
      // ==============================================================
      "parameters": {
        "jsCode": "// ======================================================\n// 图片/文件提取（统一处理多种消息类型）\n// 支持：post消息中的图片、image类型、file类型\n// ======================================================\nconst webhookData = $('Webhook-飞书入口').item.json;\nconst event = webhookData.body.event;\nconst message = event.message;\nconst content = JSON.parse(message.content);\nconst items = [];\n\nif (message.message_type === 'post') {\n  // 遍历 post 消息的所有元素，找 img 标签\n  for (const row of content.content || []) {\n    for (const item of row) {\n      if (item.tag === 'img' && item.image_key) {\n        items.push({\n          json: {\n            file_key: item.image_key,\n            file_name: `image_${item.image_key}.jpg`,\n            message_id: message.message_id,\n            chat_id: message.chat_id,\n            user_id: event.sender.sender_id.open_id,\n            file_type: 'image'\n          }\n        });\n      }\n    }\n  }\n} else if (message.message_type === 'image') {\n  items.push({\n    json: {\n      file_key: content.image_key,\n      file_name: `image_${content.image_key}.jpg`,\n      message_id: message.message_id,\n      chat_id: message.chat_id,\n      user_id: event.sender.sender_id.open_id,\n      file_type: 'image'\n    }\n  });\n} else if (message.message_type === 'file') {\n  const files = content.files || [];\n  for (const file of files) {\n    items.push({\n      json: {\n        file_key: file.file_key,\n        file_name: file.file_name || 'file',\n        message_id: message.message_id,\n        chat_id: message.chat_id,\n        user_id: event.sender.sender_id.open_id,\n        file_type: 'file'\n      }\n    });\n  }\n}\n\n// 可观测：记录提取到的附件数量\nconsole.log(JSON.stringify({\n  level: 'INFO',\n  step: 'file_extracted',\n  count: items.length,\n  types: items.map(i => i.json.file_type)\n}));\n\nreturn items;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
