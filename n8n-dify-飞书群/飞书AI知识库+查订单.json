    {
      // ==============================================================
      // 节点 5：获取飞书 Tenant Access Token
      // 作用：动态拿 token，TTL=2h，避免硬编码
      // 密钥隔离：FEISHU_APP_ID / FEISHU_APP_SECRET 来自 .env
      // ==============================================================
      "parameters": {
        "jsCode": "// ======================================================\n// 获取飞书 Tenant Access Token\n// 坑3修复：之前 token 有效期硬编码，现在动态获取\n// 工程化：token 放入全局缓存，避免每次请求都调一次 auth 接口\n// ======================================================\nconst CACHE_KEY = 'feishu_tenant_token';\nconst CACHE_TTL = 7100 * 1000; // 2h - 10min buffer\n\n// 检查缓存\nif (global.feishuTokenCache && \n    global.feishuTokenCache.expiresAt > Date.now()) {\n  console.log(JSON.stringify({\n    level: 'INFO', step: 'token_cache_hit',\n    cached_at: global.feishuTokenCache.cachedAt\n  }));\n  return [{ json: { token: global.feishuTokenCache.token } }];\n}\n\n// 缓存未命中 -> 调用飞书 auth 接口\nconst response = await this.helpers.httpRequest({\n  method: 'POST',\n  url: 'https://open.feishu.cn/open-apis/auth/v3/tenant_access_token/internal',\n  body: {\n    app_id: '{{ $env.FEISHU_APP_ID }}',\n    app_secret: '{{ $env.FEISHU_APP_SECRET }}'\n  },\n  json: true\n});\n\n// 缓存结果\nglobal.feishuTokenCache = {\n  token: response.tenant_access_token,\n  cachedAt: Date.now(),\n  expiresAt: Date.now() + CACHE_TTL\n};\n\nconsole.log(JSON.stringify({\n  level: 'INFO', step: 'token_fetched',\n  expires_in: response.expire, cached_for_ms: CACHE_TTL\n}));\n\nreturn [{ json: { token: response.tenant_access_token } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
