    {
      "parameters": {
        "jsCode": "const webhookData = $('Webhook-飞书入口').item.json;\nconst event = webhookData.body.event;\nconst message = event.message;\nconst content = JSON.parse(message.content);\n\nconst items = [];\n\n// 提取所有 image_key（post 类型里）\nif (message.message_type === 'post') {\n  for (const row of content.content || []) {\n    for (const item of row) {\n      if (item.tag === 'img' && item.image_key) {\n        items.push({\n          json: {\n            file_key: item.image_key,\n            file_name: `image_${item.image_key}.jpg`,\n            message_id: message.message_id,\n            chat_id: message.chat_id,\n            user_id: event.sender.sender_id.open_id\n          }\n        });\n      }\n    }\n  }\n}\n// 单图类型\nelse if (message.message_type === 'image') {\n  items.push({\n    json: {\n      file_key: content.image_key,\n      file_name: `image_${content.image_key}.jpg`,\n      message_id: message.message_id,\n      chat_id: message.chat_id,\n      user_id: event.sender.sender_id.open_id\n    }\n  });\n}\n// 文件类型\nelse if (message.message_type === 'file') {\n  const files = content.files || [];\n  for (const file of files) {\n    items.push({\n      json: {\n        file_key: file.file_key,\n        file_name: file.file_name || 'file',\n        message_id: message.message_id,\n        chat_id: message.chat_id,\n        user_id: event.sender.sender_id.open_id\n      }\n    });\n  }\n}\n\nreturn items;"
      },
