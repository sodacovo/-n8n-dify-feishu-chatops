            {"name": "content", "value": "={{ JSON.stringify({\n  config: { wide_screen_mode: true },\n  elements: [\n    {\n      tag: 'markdown',\n      content: $('HTTP-调用Dify AI问答').item.json.answer || '抱歉，AI 暂时无法回答这个问题。'\n    },\n    { tag: 'hr' },\n    {\n      tag: 'note',\n      elements: [\n        { tag: 'plain_text', content: 'ZD-AI 智能助手 · ' + ($('Code-幂等去重').item.json.event_id || '').slice(0, 8) }\n      ]\n    }\n  ]\n}) }}"},
            {"name": "msg_type", "value": "interactive"}
          ]
        },
        "options": {}
      },
