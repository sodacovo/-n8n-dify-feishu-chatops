    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst urls = items.map(item => {\n  let location = item.json.Location || \n                 item.json.url ||\n                 item.json.cos_url || '';\n  \n  // 补上 https://\n  if (location && !location.startsWith('http')) {\n    location = 'https://' + location;\n  }\n  \n  return location;\n}).filter(url => url);\n\nconst imageArray = urls.map(url => ({\n  type: 'image_url',\n  image_url: { url: url }\n}));\n\nreturn [{\n  json: {\n    content_array: imageArray,\n    content_json: JSON.stringify([\n      ...imageArray,\n      { type: 'text', text: '请描述这些图片' }\n    ])\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -224,
        64
      ],
      "id": "673895ef-7982-472e-869a-1dcd555eeb5a",
      "name": "获取图片url"
    },
    {
      "parameters": {
        "jsCode": "let imageAnalysis = '';\nlet imageCount = 0;\n\ntry {\n  const imageData = $('图片解析').first().json;\n  \n  if (imageData?.choices) {\n    // 原始 API 响应\n    imageAnalysis = imageData.choices[0]?.message?.content || '';\n  } else {\n    // 处理过的格式\n    imageAnalysis = imageData?.analysis || '';\n  }\n  imageCount = imageData?.image_count || 0;\n} catch (e) {\n  // 没图\n}\n\n// 拿 Webhook 飞书数据\nconst webhookData = $('Webhook-飞书入口').first().json;\nconst event = webhookData.body?.event || webhookData.event || webhookData;\nconst message = event.message;\n\n// 提取用户问题\nlet userQuestion = '';\ntry {\n  const content = JSON.parse(message.content);\n  \n  if (message.message_type === 'text') {\n    userQuestion = content.text || '';\n  } else if (message.message_type === 'post') {\n    for (const row of content.content || []) {\n      for (const item of row) {\n        if (item.tag === 'text' && item.text) {\n          userQuestion += item.text;\n        }\n      }\n    }\n  } else if (message.message_type === 'image') {\n    userQuestion = '请描述这张图片';\n  }\n} catch (e) {\n  userQuestion = '';\n}\n\nconst userQ = userQuestion.trim() || '请结合图片回答';\n\n// 拼接\nlet finalQuestion;\nif (imageAnalysis && imageAnalysis.length > 0) {\n  finalQuestion = `用户：${userQ}\\n图片解析：${imageAnalysis}`;\n} else {\n  finalQuestion = `用户：${userQ}`;\n}\n\nreturn [{\n  json: {\n    question: finalQuestion,\n    chat_id: message.chat_id,\n    user_id: event.sender?.sender_id?.open_id,\n    message_id: message.message_id,\n    has_image: !!imageAnalysis\n  }\n}];"
      },
