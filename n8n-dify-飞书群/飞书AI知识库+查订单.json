      // 坑3修复：用飞书消息卡片替代纯文本，支持二段式交互\n      // 工程化：
      //   - Markdown 格式，代码块高亮\n      //   - 底部显示 request_id（可追溯）\n      //   - 可扩展按钮回调到 n8n\n      // ==============================================================
      "parameters": {
        "method": "POST",
        "url": "https://open.feishu.cn/open-apis/im/v1/messages?receive_id_type=chat_id",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "Authorization", "value": "=Bearer {{ $('Code-拿Token').item.json.token }}"},
